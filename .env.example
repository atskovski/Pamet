# Pamet v1.1.0 — example only. Never commit real credentials.
PORT=8080
NODE_ENV=production
APP_BASE_URL=https://pamet.wasmer.app

# Wasmer MySQL
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_CONNECTION_LIMIT=10
# Keep false in production; apply db/schema.sql as a deliberate migration step.
AUTO_MIGRATE=false
# Alternatively: DATABASE_URL=mysql://user:password@host:3306/database

# Stripe — secret values belong in Wasmer/deployment secrets, not GitHub
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ULTRA_MONTHLY=
STRIPE_PRICE_ULTRA_ANNUAL=

# Set only in local automated tests; production rate limits must remain enabled.
DISABLE_RATE_LIMITS=false

# Shared Redis/Valkey store for rate limits. Required in production.
REDIS_URL=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Pamet <hello@your-verified-domain.example>

# Weekly digest scheduler
CRON_SECRET=

# Web Push. Generate once with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:security@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Encrypts server-side MFA secrets. Exactly 64 hexadecimal characters.
IDENTITY_ENCRYPTION_KEY=

# Optional product-feedback routing. Payloads contain only the submitted feedback fields.
FEEDBACK_WEBHOOK_URL=
FEEDBACK_WEBHOOK_TOKEN=

# Optional observability collector and protected Prometheus scrape endpoint.
LOG_DRAIN_URL=
LOG_DRAIN_TOKEN=
METRICS_SECRET=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
