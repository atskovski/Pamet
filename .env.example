# Pamet v1.1.0 — example only. Never commit real credentials.
PORT=8080
NODE_ENV=production
APP_BASE_URL=https://pamet.wasmer.app

# Wasmer MySQL
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_CONNECTION_LIMIT=10
# Keep false in production; apply db/schema.sql as a deliberate migration step.
AUTO_MIGRATE=false
# Alternatively: DATABASE_URL=mysql://user:password@host:3306/database

# Stripe — secret values belong in Wasmer/deployment secrets, not GitHub
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ULTRA_MONTHLY=
STRIPE_PRICE_ULTRA_ANNUAL=

# Set only in local automated tests; production rate limits must remain enabled.
DISABLE_RATE_LIMITS=false

# Optional preferred shared Redis/Valkey store. When absent, Pamet uses its
# transactional MySQL limiter so limits still work across multiple instances.
REDIS_URL=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Pamet <hello@your-verified-domain.example>

# Weekly digest scheduler
CRON_SECRET=

# Web Push. Generate once with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:security@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Encrypts server-side MFA secrets. Exactly 64 hexadecimal characters.
IDENTITY_ENCRYPTION_KEY=

# Optional product-feedback routing. Payloads contain only the submitted feedback fields.
FEEDBACK_WEBHOOK_URL=
FEEDBACK_WEBHOOK_TOKEN=

# Optional observability collector and protected runtime/Prometheus endpoints.
# Grafana Cloud OTLP uses the stack endpoint, numeric instance ID, and a
# least-privilege access-policy token with logs:write and metrics:write only.
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_USERNAME=
GRAFANA_OTLP_TOKEN=
LOG_DRAIN_URL=
LOG_DRAIN_TOKEN=
METRICS_SECRET=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=

# Roadmap capability gates. Keep future clinical/collaboration/encryption features
# disabled until their implementation, review, and acceptance gates are complete.
PAMET_FEATURE_PATTERN_CONFIDENCE=false
PAMET_FEATURE_VISIT_BRIEF_SELECTION=false
PAMET_FEATURE_QUICK_LOG=false
PAMET_FEATURE_CARE_CIRCLES=false
PAMET_FEATURE_APPOINTMENT_PREP=false
PAMET_FEATURE_ENCRYPTED_JOURNAL=false
# Local JSON export is already supported by the browser store and is safe to expose.
PAMET_FEATURE_DATA_EXPORT=true
PAMET_FEATURE_PUSH_HEALTH=false
PAMET_FEATURE_OPS_DASHBOARD=false
