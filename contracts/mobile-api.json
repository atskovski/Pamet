{
  "contractVersion": 1,
  "minimumBackendVersion": "1.2.0",
  "basePath": "/api",
  "authentication": {
    "mechanism": "Secure HttpOnly session cookie",
    "sameAccountAcrossPlatforms": true
  },
  "endpoints": {
    "health": "GET /health",
    "register": "POST /auth/register",
    "login": "POST /auth/login",
    "logout": "POST /auth/logout",
    "session": "GET /auth/session",
    "passwordResetRequest": "POST /account/recovery/request",
    "passwordResetComplete": "POST /account/recovery/complete",
    "entitlements": "GET /entitlements",
    "appointments": "GET|POST|DELETE /appointments",
    "feedback": "POST /feedback",
    "billingConfig": "GET /billing/config",
    "billingStatus": "GET /billing/status",
    "billingPortal": "POST /billing/portal",
    "weeklyDigest": "POST /preferences/weekly-digest",
    "encryptedSync": "GET|PUT /sync/:profileId",
    "sharing": "GET|POST|DELETE /sharing/invites"
  },
  "privacy": {
    "journalPayloadsInOperationalLogs": false,
    "healthDetailsInNotifications": false,
    "diagnosisOrTreatment": false
  }
}

